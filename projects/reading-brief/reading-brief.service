[Unit]
Description=Generate the daily reading brief

[Service]
Type=oneshot
WorkingDirectory=%h/homelab-projects/reading-brief
EnvironmentFile=%h/.config/reading-brief/environment
ExecStart=/usr/bin/bash %h/homelab-projects/reading-brief/run-brief.sh
ExecStopPost=-/usr/bin/docker compose --profile inference stop model
TimeoutStartSec=25min
UMask=0077
