    {
      "datasource": {"type": "prometheus", "uid": "security-prometheus"},
      "description": "Whether the latest scan attempt completed every configured scanner and promoted a baseline. No data means health telemetry is missing.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 0, "text": "FAILED"},
                "1": {"color": "green", "index": 1, "text": "PASSED"}
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "12.4.1",
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "security-prometheus"},
          "editorMode": "code",
          "expr": "max(trivy_scan_success)",
          "instant": true,
          "legendFormat": "Latest attempt",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Latest Scan Attempt",
      "type": "stat"
    },
