# New top-level paths are ignored until reviewed and added to this list.
*

!.gitignore
!LICENSE
!README.md
!ROADMAP.md
!SECURITY.md

!.github/
!.github/**
!apps/
!apps/**
!media/
!media/**
!proxmox/
!proxmox/**
!networking/
!networking/**
!storage/
!storage/**
!monitoring/
!monitoring/**
!security/
!security/**
!automation/
!automation/**
!diagrams/
!diagrams/**
!docs/
!docs/**
!screenshots/
!scripts/
!scripts/**
!tests/
!tests/**

# Keep agent instructions local.
AGENTS.md

# Keep generated validation output out of the repository.
**/__pycache__/
*.py[cod]
automation/trivy/repositories.tsv
automation/trivy/var/
**/.terraform/
*.tfstate*
*.tfplan
proxmox/terraform/terraform.tfvars

# Screenshots require an explicit force-add after review.
screenshots/*
!screenshots/README.md
