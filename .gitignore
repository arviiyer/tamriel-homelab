# Keep agent instructions local.
AGENTS.md

# Keep generated validation output out of the repository.
**/__pycache__/
*.py[cod]
automation/trivy/repositories.tsv
automation/trivy/var/

# Screenshots require an explicit force-add after redaction and review.
evidence/screenshots/*
!evidence/screenshots/README.md
