{
  "uid": "host-metrics-example",
  "title": "Host metrics example",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Exporter reachable",
      "description": "One means the last scrape succeeded. Missing data stays missing.",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "example-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"node\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 2,
      "title": "Memory available",
      "description": "Available memory as a percentage of total host memory.",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "example-prometheus"},
      "targets": [{"refId": "A", "expr": "100 * node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "id": 3,
      "title": "Root filesystem available",
      "description": "Space available to ordinary users on the host root filesystem.",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "example-prometheus"},
      "targets": [{"refId": "A", "expr": "100 * node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "id": 4,
      "title": "CPU busy",
      "description": "Average non-idle CPU time across cores. Allow a few scrapes for the rate.",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "example-prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[1m])))", "legendFormat": "{{host}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    }
  ]
}
